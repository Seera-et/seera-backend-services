# Copy to .env for local development. .env is gitignored — never commit secrets.
# Every variable here is read once, at startup, by internal/config.

ENV=dev
PORT=8080
LOG_LEVEL=debug

# Matches docker-compose.yml.
DATABASE_URL=postgres://seera:seera@localhost:5432/seera?sslmode=disable
#
# Against hosted Supabase instead, use the *session* pooler on 5432 — not the
# direct connection (IPv6-only, unreachable from Cloud Run) and not the
# transaction pooler on 6543 (breaks pgx's prepared-statement cache):
#
#   DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# See docs/DEPLOY.md. Migrations run on boot either way; scripts/db-seed.sh
# copies the local corpus across so the embeddings are not paid for twice.

# AI provider credentials.
#
# Not required to boot: each adapter refuses to build with an empty key, and a
# feature whose provider is missing leaves its route unregistered rather than
# failing on every call. Startup warns about whichever are absent.
#
# GEMINI_API_KEY alone is enough to run the whole answer path — it covers both
# embeddings (gemini-embedding-001 at 1536 dims) and generation. It is also the
# preferred embedder: the corpus is half Amharic and Gemini's multilingual
# coverage is materially better than text-embedding-3-large's.
GEMINI_API_KEY=

# Generation model. Empty uses gemini-3.5-flash, picked on measured
# time-to-first-token (2.1s vs 52.9s for 3.6-flash; 3.7-flash returns 503).
# Pinned deliberately — the evaluation gate measures grounding against a
# baseline, and gemini-flash-latest would move the model underneath it.
GEMINI_MODEL=

# Optional alternatives and additions:
#   OPENAI_API_KEY    — embeddings, used only if GEMINI_API_KEY is unset
#   COHERE_API_KEY    — reranking; without it, fused retrieval order goes
#                       straight to the model and abstention falls back to
#                       "no candidates at all"
#   ANTHROPIC_API_KEY — reserved; no adapter wired
OPENAI_API_KEY=
COHERE_API_KEY=
ANTHROPIC_API_KEY=

# Authentication. The Supabase project that issues user tokens, e.g.
# https://<ref>.supabase.co — not a secret: it names the token issuer and
# locates the public JWKS the API verifies signatures against. Supabase holds
# the Google client secret; this process never sees it.
#
# When empty, every route that costs money or belongs to one person is left
# unregistered — Q&A, the advisor, and /me all 404. That is deliberate: a
# forgotten config value should not quietly reopen the expensive endpoints.
SUPABASE_PROJECT_URL=
#
# The `aud` claim required on a user token. Supabase issues "authenticated" for
# signed-in users and "anon" for the publishable key, which ships in the browser
# bundle — so this is checked rather than assumed. Change only for a custom
# Supabase setup.
SUPABASE_JWT_AUDIENCE=authenticated

# Guards POST /api/v1/admin/documents/ingest. When empty the route is not
# registered at all — an unauthenticated write path into the legal corpus must
# not exist even by accident. Generate one with:
#   openssl rand -hex 32
ADMIN_API_TOKEN=

# The answer path's second retrieval pass: after the first results come back, the
# model is asked which further articles they cross-reference, and those are
# fetched too. Better recall on questions that span several provisions, at the
# cost of one model call and one retrieval charged directly to
# time-to-first-token. Off until the evaluation says the trade is worth it:
#   go test -tags eval ./tests/evaluation/...
ANSWER_MULTI_HOP=false

# Comma-separated. Defaults to the Vite dev server origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# HTTP tuning. There is no write timeout by design — see internal/server.New:
# an absolute write deadline truncates SSE answer streams mid-sentence.
READ_HEADER_TIMEOUT=10s
IDLE_TIMEOUT=120s
SHUTDOWN_TIMEOUT=20s
MAX_REQUEST_BYTES=1048576

# Separate, much larger cap for admin ingestion: a parsed legal code runs to
# several megabytes of JSON. 32 MiB.
MAX_INGEST_BYTES=33554432

# Paces ingestion to stay inside the embedding provider's quota, in texts per
# minute. Gemini's free tier allows 100/min, so 90 leaves room for the query
# embeddings user traffic generates in the same window. Set 0 on a paid tier.
# An 800-article code takes about ten minutes at 90/min — that is the quota, not
# the code being slow.
#
# Note there are two free-tier limits and pacing only helps with one: ~100 texts
# per minute (wait it out) and ~1000 per day (wait for the reset or enable
# billing). Roughly 1000 chunks a day is one mid-sized code, so a real corpus
# needs a paid key.
EMBED_TEXTS_PER_MINUTE=90

# Per-IP limit on /api/v1: sustained requests per second, and burst.
RATE_LIMIT_RPS=1
RATE_LIMIT_BURST=5
