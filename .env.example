# Copy to .env for local development. .env is gitignored — never commit secrets.

SEERA_ENV=dev

HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=20s

# Matches docker-compose.yml
DATABASE_URL=postgres://seera:seera@localhost:5432/seera?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_CONNECT_TIMEOUT=10s
DB_MAX_CONN_LIFETIME=1h

LOG_LEVEL=debug
LOG_FORMAT=text

# Provider credentials are read by the adapters in internal/provider once they
# land. Keep them out of source and out of logs.
# ANTHROPIC_API_KEY=
# EMBEDDING_MODEL=
